# Copy this file to .env and fill in your real values.
# Never commit .env to version control.

PORT=3000
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

# Set TRUST_PROXY=1 only when the app runs behind a trusted reverse proxy
# (for example a managed hosting platform). Never set it on a server that is
# directly exposed to the internet, or clients can spoof their IP address.
# TRUST_PROXY=1
